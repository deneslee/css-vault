---
// src/pages/index.astro
import { getCollection } from "astro:content";
import { createHighlighter } from "shiki";
import Layout from "../layouts/Layout.astro";
import SnippetGallery from "../components/SnippetGallery";
import { rebaseAssetUrls, type SnippetData } from "../lib/snippet";

const base = import.meta.env.BASE_URL;

const entries = (await getCollection("snippets")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const highlighter = await createHighlighter({
  themes: ["github-dark-default", "github-light-default"],
  langs: ["css", "tsx", "html"],
});

const highlight = (code: string, lang: "css" | "tsx" | "html") =>
  highlighter.codeToHtml(code.trimEnd(), {
    lang,
    themes: { dark: "github-dark-default", light: "github-light-default" },
    defaultColor: false,
  });

const snippets: SnippetData[] = entries.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  category: entry.data.category,
  tags: entry.data.tags,
  previewScale: entry.data.previewScale,
  previewScroll: entry.data.previewScroll,
  controls: entry.data.controls,
  cssCode: entry.data.cssCode,
  htmlCode: entry.data.htmlCode,
  reactCode: entry.data.reactCode,
  previewCss: rebaseAssetUrls(entry.data.cssCode, base),
  previewHtml: rebaseAssetUrls(entry.data.htmlCode, base),
  highlighted: {
    css: highlight(entry.data.cssCode, "css"),
    react: highlight(entry.data.reactCode, "tsx"),
    html: highlight(entry.data.htmlCode, "html"),
  },
  // Heading ids would repeat across cards; they are not linked to anyway.
  notesHtml: (entry.rendered?.html ?? "").replace(/\sid="[^"]*"/g, ""),
}));
---

<Layout>
  <SnippetGallery snippets={snippets} client:load />
</Layout>
