---
// src/pages/index.astro
import { getCollection } from "astro:content";
import SnippetGallery from "../components/SnippetGallery";
import "../styles/global.css";

const rawSnippets = await getCollection("snippets");

const snippets = rawSnippets.map((entry) => ({
  id: entry.id,
  title: entry.data.title, //[cite: 1]
  category: entry.data.category, //[cite: 1]
  tags: entry.data.tags, //[cite: 1]
  defaultSpeed: entry.data.defaultSpeed, //[cite: 1]
  cssCode: entry.data.cssCode, //[cite: 1]
  htmlCode: entry.data.htmlCode, //[cite: 1]
  reactCode: entry.data.reactCode, //[cite: 1]
}));
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CSS Vault</title>
  </head>
  <body>
    <SnippetGallery snippets={snippets} client:load />
  </body>
</html>
