---
// src/layouts/Layout.astro
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CSS Vault",
  description = "A collection of CSS snippets — animations, sprites and UI effects you can preview, tune and copy as CSS, HTML or React.",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en" data-theme="vault-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <script is:inline>
      // Runs before first paint so the page never flashes the wrong theme.
      (function () {
        var theme = "vault-dark";
        try {
          var stored = localStorage.getItem("css-vault-theme");
          if (stored === "vault-dark" || stored === "vault-light") theme = stored;
          else if (window.matchMedia("(prefers-color-scheme: light)").matches) theme = "vault-light";
        } catch (e) {}
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-base-200 text-base-content">
    <slot />
  </body>
</html>
